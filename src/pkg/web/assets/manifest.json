{
  "name": "drop",
  "short_name": "drop",
  "description": "Your devices, and what they share with you.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e0b14",
  "theme_color": "#0e0b14",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["*/*"] }]
    }
  }
}
