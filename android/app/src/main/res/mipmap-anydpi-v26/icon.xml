<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher draws the foreground over the background and masks both to whatever shape the
     device uses, so the mark is inset: what falls outside the safe circle is cut off. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ground" />
    <foreground android:drawable="@mipmap/icon_foreground" />
</adaptive-icon>
