<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gio draws everything itself, so the system decoration is only there while the window opens.
         The violet keeps that moment from flashing a different colour than the app. -->
    <style name="Theme.GioApp" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/brand</item>
    </style>
</resources>
